# kbpad: keep chosen keyboards awake (fix for I-08, "Bloody keeps dropping").
# Generated by `kbpad doctor` per keyboard; {VENDOR} and {PRODUCT} are 4-digit hex from lsusb.
ACTION=="add", SUBSYSTEM=="usb", ATTR{idVendor}=="{VENDOR}", ATTR{idProduct}=="{PRODUCT}", TEST=="power/control", ATTR{power/control}="on"
